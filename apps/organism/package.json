    "test:art-direction-browser": "node --import tsx scripts/art-direction-browser-harness.mts",
    "test:browser": "node --import tsx scripts/browser-harness.mts && node --import tsx scripts/settings-browser-harness.mts && node --import tsx scripts/editor-material-browser-harness.mts && node --import tsx scripts/art-direction-browser-harness.mts",
    "test:browser-verified": "node --import tsx scripts/center-panes-browser-harness.mts && node --import tsx scripts/file-pane-browser-harness.mts && node --import tsx scripts/pane-parity-browser-harness.mts && node --import tsx scripts/wires-panel-browser-harness.mts && node --import tsx scripts/workspace-selector-browser-harness.mts && node --import tsx scripts/native-workspace-switcher-gardend-browser.mts",
