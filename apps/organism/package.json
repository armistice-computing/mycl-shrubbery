  },
  "scripts": {
    "dev": "vite",
    "dev:live": "GARDEND_LOOPBACK_MANIFEST=\"$HOME/Library/Application Support/dev.sophia.garden/profiles/default/loopback.json\" SHRUBBERY_CELL_PROXY_TIMEOUT_MS=120000 vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:cell-proxy": "vitest run tests/vite-cell-proxy.integration.test.ts",
    "gardend:dev": "tsx scripts/gardend-dev.mts",
