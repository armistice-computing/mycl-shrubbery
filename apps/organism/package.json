{
  "name": "@shrubbery/organism",
  "version": "0.0.0",
  "description": "The ORGANISM playground \u2014 a plain Vite app that boots the REAL render host (@shrubbery/runtime) + chrome components (@shrubbery/components) against REAL RDF. No backend, no mock.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "exports": {
    "./cell/loopback-mcp": "./src/cell/loopback-mcp.ts",
    "./cell/app-routes": "./src/cell/app-routes.ts",
    "./cell/public-shell": "./src/cell/public-shell.ts",
    "./cell/spawn-gardend": "./src/cell/spawn-gardend.ts",
    "./cell/loopback-crdt-backend": "./src/cell/loopback-crdt-backend.ts",
