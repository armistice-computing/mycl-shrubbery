    "test:center-panes-gardend-browser": "node --import tsx scripts/center-panes-gardend-browser.mts",
    "test:daily-note-browser": "node --import tsx scripts/daily-note-browser-harness.mts",
    "test:pdf-reader-browser": "node --import tsx scripts/pdf-reader-browser.mts",
    "test:document-activation-browser": "node --import tsx scripts/document-activation-gardend-browser.mts",
    "test:imported-readiness": "node --import tsx scripts/imported-graph-readiness-probe.mts",
    "test:imported-graph": "node --import tsx scripts/imported-graph-new-document-browser.mts",
    "test:csp-inline-style": "node --import tsx scripts/csp-inline-style-webkit.mts",
    "test:cross-origin-headers": "node --import tsx scripts/cross-origin-incarnation-probe.mts",
    "test:incarnation-headers": "node --import tsx scripts/incarnation-header-browser.mts",
    "test:literata-clamp": "node --import tsx scripts/literata-clamp-browser.mts",
    "test:right-panel-launch": "node --import tsx scripts/right-panel-launch-browser.mts",
