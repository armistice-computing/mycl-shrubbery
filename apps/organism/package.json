    "test:editor-arrow-across-blocks": "node --import tsx scripts/editor-arrow-across-blocks-browser.mts",
    "test:recents-surfaces": "node --import tsx scripts/recents-surfaces-browser.mts",
    "test:graph-idle": "node --import tsx scripts/graph-idle-browser.mts",
    "test:editor-select-across-blocks": "node --import tsx scripts/editor-select-across-blocks-browser.mts",
    "test:app-csp-styles": "node --import tsx scripts/app-csp-styles-browser.mts",
